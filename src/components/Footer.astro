---
import { profile } from "../data/cv";

interface Props {
  // The page has the painted picture. The footer says what the picture shows.
  scene?: boolean;
}

const { scene = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer mono-label">
  {
    scene && (
      <p class="note">
        Illustrations of places with meaning in my life, drawn with code in your browser from reference pictures taken by me or from
        descriptions of how I remember them.
      </p>
    )
  }
  <p>© {year} {profile.name}</p>
</footer>

<style>
  .footer {
    padding: 28px var(--set-end) 40px var(--rail);
    color: var(--muted-foreground);
    text-align: center;
  }

  .note {
    max-width: 62ch;
    margin: 0 auto 18px;
    line-height: 1.7;
    text-wrap: balance;
  }
</style>

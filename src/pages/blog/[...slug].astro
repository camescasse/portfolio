---
import { getCollection, render } from "astro:content";
import SheetHead from "../../components/SheetHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { longDate, readMinutes } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <div class="sheets">
    <article class="sheet">
      <SheetHead code="B" label="Blog" meta={`${longDate(post.data.date)} · ${readMinutes(post.body)} min`} as="span" />
      <h1 class="title">{post.data.title}</h1>
      <div class="prose">
        {post.data.image && <img src={post.data.image} alt="" />}
        <Content />
      </div>
      <p class="back mono-label"><a href="/blog">← All posts</a></p>
    </article>
  </div>
</BaseLayout>

<style>
  .prose {
    max-width: 68ch;
    margin-top: 28px;
    font-size: 19px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .prose :global(p),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin-top: 1.1em;
  }

  .prose :global(:is(h2, h3, h4)) {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.35;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration-color: var(--link-line);
    text-underline-offset: 4px;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin-bottom: 8px;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .back {
    margin-top: 48px;
  }

  .back a {
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }

  @media (width < 48rem) {
    .prose {
      font-size: 17px;
    }
  }
</style>

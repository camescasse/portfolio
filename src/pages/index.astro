---
import { getCollection } from "astro:content";
import SheetHead from "../components/SheetHead.astro";
import WorkGraph from "../components/WorkGraph.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, links, profile, projects, skills, work } from "../data/cv";
import { monthStamp, readMinutes } from "../lib/posts";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const current = work.find((job) => job.now);
const firstYear = work[0].meta.match(/\d{4}/)?.[0];
const sheetCount = 6;
const sheet = (n: number) => `Sheet ${n} of ${sheetCount}`;
---

<BaseLayout>
  <div class="sheets">
    <section class="sheet" aria-labelledby="name">
      <SheetHead code="A-01" label="Letter" meta={sheet(1)} as="span" />
      <h1 id="name" class="title">{profile.name}</h1>
      <p class="letter">
        Hi, I’m Eric. I am a {profile.role.toLowerCase()} at {current?.company}, where I own end-to-end testing for
        healthcare platforms. I am passionate about complex problem solving and building useful software products. I
        prioritize optimizing workflows and crafting efficient, straightforward solutions. I approach problems with
        simplicity, focusing on the essentials and avoiding premature optimization. My goal is to minimize complexity and
        create clean, effective software. Read my <a class="ref" href="/cv">CV</a>, the
        <a class="ref" href="/blog">blog</a>, or <a class="ref" href={`mailto:${profile.email}`}>write to me</a>.
      </p>
    </section>

    <section class="sheet" id="work">
      <SheetHead code="A-02" label="Work" meta={`${sheet(2)} · ${firstYear}–${new Date().getFullYear()}`} />
      <WorkGraph />
    </section>

    <section class="sheet" id="projects">
      <SheetHead code="A-03" label="Projects" meta={`${sheet(3)} · ${projects.length} entries`} />
      <ol class="projects">
        {
          projects.map((project, i) => (
            <li class="project" id={project.slug}>
              <span class="p-no mono-label">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="p-name">{project.name}</h3>
                <p class="p-desc">
                  {project.description
                    .split("[redacted]")
                    .flatMap((part, j) => (j === 0 ? [part] : [<span class="redacted mono-label">[redacted]</span>, part]))}
                </p>
              </div>
              <ul class="p-stack mono-label">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sheet" id="skills">
      <SheetHead code="A-04" label="Skills" meta={sheet(4)} />
      <dl class="table">
        {
          skills.map((skill) => (
            <div class="t-row">
              <dt class="mono-label">{skill.key}</dt>
              <dd>{skill.value.join(", ")}</dd>
            </div>
          ))
        }
        <div class="t-row">
          <dt class="mono-label">Education</dt>
          <dd>
            {education.degree}, {education.school} <span class="t-meta mono-label">{education.dates}</span>
          </dd>
        </div>
      </dl>
    </section>

    <section class="sheet" id="writing">
      <SheetHead code="A-05" label="Writing" meta={`${sheet(5)} · ${posts.length} entries`} />
      <div class="thead mono-label" aria-hidden="true">
        <span>Date</span>
        <span>Title</span>
        <span class="c-read">Read</span>
      </div>
      <ol class="index">
        {
          posts.map((post) => (
            <li class="row">
              <time class="c-date" datetime={post.data.date.toISOString()}>
                {monthStamp(post.data.date)}
              </time>
              <a class="c-title" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
              <span class="c-read">{readMinutes(post.body)} min</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sheet" id="contact">
      <SheetHead code="A-06" label="Contact" meta={sheet(6)} />
      <div class="contact">
        <p class="key mono-label">Email</p>
        <div class="mail">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="copy mono-label" type="button" data-copy={profile.email}>Copy</button>
        </div>
        <ul class="links">
          {
            links.map((link) => (
              <li>
                <span class="key mono-label">{link.key}</span>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Failed";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
</script>

<style>
  .letter {
    max-width: 62ch;
    margin-top: 28px;
    font-size: 22px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Projects */
  .projects {
    margin-top: 28px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--edge);
  }

  .project {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 240px;
    gap: 20px;
    padding-block: 20px 24px;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 16px;
  }

  .project:target .p-name {
    color: var(--accent);
  }

  .p-no {
    padding-top: 6px;
    color: var(--muted-foreground);
  }

  .p-name {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.3;
  }

  .p-desc {
    max-width: 68ch;
    margin-top: 8px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .redacted {
    padding: 1px 5px;
    border-radius: 2px;
    background: var(--foreground);
    color: var(--background);
    white-space: nowrap;
  }

  .p-stack {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 6px;
    padding: 4px 0 0;
    list-style: none;
    color: var(--muted-foreground);
  }

  .p-stack li {
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 2px;
  }

  /* Skills */
  .table {
    margin: 28px 0 0;
    border-top: 1px solid var(--edge);
  }

  .t-row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: baseline;
    gap: 20px;
    padding-block: 12px;
    border-bottom: 1px solid var(--border);
  }

  .t-row dt {
    color: var(--muted-foreground);
  }

  .t-row dd {
    margin: 0;
    font-size: 17px;
    font-weight: 400;
  }

  .t-meta {
    margin-left: 8px;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  /* Writing */
  .index {
    padding: 0;
    list-style: none;
  }

  .row,
  .thead {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 72px;
    align-items: baseline;
    gap: 20px;
    padding-block: 12px;
    border-bottom: 1px solid var(--border);
  }

  .thead {
    margin-top: 28px;
    padding-block: 8px;
    border-bottom-color: var(--edge);
    color: var(--muted-foreground);
  }

  .row {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .c-title {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 400;
    text-decoration: none;
  }

  .c-title:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--edge);
    text-underline-offset: 4px;
  }

  .c-date,
  .c-read {
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .c-read {
    text-align: right;
  }

  /* Contact */
  .contact {
    margin-top: 28px;
  }

  .key {
    display: block;
    margin-bottom: 12px;
    color: var(--muted-foreground);
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 20px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .mail a {
    font-size: 64px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--link-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 10px;
    overflow-wrap: anywhere;
  }

  .mail a:hover {
    text-decoration-color: var(--accent);
  }

  .copy {
    position: relative;
    top: -12px;
    padding: 7px 12px;
    border: 1px solid var(--edge);
    border-radius: 3px;
    background: none;
    color: var(--foreground);
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    list-style: none;
  }

  .links li {
    padding: 18px 20px 20px;
    border-right: 1px solid var(--border);
  }

  .links li:first-child {
    padding-left: 0;
  }

  .links li:last-child {
    border-right: 0;
  }

  .links .key {
    margin-bottom: 6px;
  }

  .links a {
    font-size: 19px;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--link-line);
    text-underline-offset: 4px;
  }

  @media (width < 64rem) {
    .project {
      grid-template-columns: 48px minmax(0, 1fr);
    }

    .p-stack {
      grid-column: 2;
    }
  }

  @media (width < 48rem) {
    .letter {
      font-size: 19px;
    }

    .project {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .p-stack {
      grid-column: 1;
    }

    .p-name {
      font-size: 19px;
    }

    .p-desc {
      font-size: 16px;
    }

    .t-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .thead {
      display: none;
    }

    .row {
      grid-template-columns: auto 1fr;
      gap: 4px 12px;
      padding-block: 14px;
    }

    .row .c-title {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .row .c-read {
      grid-row: 1;
      grid-column: 2;
    }

    .index {
      margin-top: 20px;
      border-top: 1px solid var(--edge);
    }

    .mail {
      gap: 12px;
    }

    .mail a {
      font-size: 30px;
      text-underline-offset: 6px;
    }

    .copy {
      top: 0;
    }

    .links {
      grid-template-columns: 1fr 1fr;
    }

    .links li {
      padding: 14px 0 16px 16px;
    }

    .links li:nth-child(odd) {
      padding-left: 0;
    }

    .links li:nth-child(2) {
      border-right: 0;
    }

    .links li:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
  }
</style>

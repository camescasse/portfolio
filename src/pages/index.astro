---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const [aboutEntry] = await getCollection("about");
const { Content: AboutContent } = await render(aboutEntry);

const projectEntries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const experienceEntries = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order
);

function formatDate(date: Date): string {
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const day = String(date.getUTCDate()).padStart(2, "0");
  const month = months[date.getUTCMonth()];
  const year = date.getUTCFullYear();
  return `${day} ${month} ${year}`;
}
---

<BaseLayout title="Eric Camescasse - SWE">
  <div class="header">
    <div class="avatar">
      <img src="/images/avatar.jpg" alt="avatar" />
    </div>
    <div class="header-container">
      <h3 class="name">Eric Camescasse</h3>
      <p class="description">software engineer &middot; qa</p>
    </div>
  </div>

  <div class="about">
    <p class="about-title">About</p>
    <div class="about-content">
      <AboutContent />
    </div>
  </div>

  <div class="essays">
    <div class="essays-title">
      <p>Essays</p>
    </div>

    {posts.slice(0, 3).map((post) => (
      <>
        <div class="blog-date">
          <p>{formatDate(post.data.date)}</p>
        </div>
        <div class="blog-entry">
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </div>
      </>
    ))}

    {posts.length > 3 && (
      <div class="blog-archive">
        <a href="/blog/">See more</a>
      </div>
    )}
  </div>

  <div class="projects">
    <div class="projects-title">
      <p>Projects</p>
    </div>
    {projectEntries.map(async (project) => {
      const { Content } = await render(project);
      return (
        <>
          <div class="project-entry">
            <p>
              {project.data.url ? (
                <a href={project.data.url} target="_blank" rel="noopener noreferrer">
                  {project.data.title}
                </a>
              ) : (
                project.data.title
              )}
            </p>
          </div>
          <div class="project-description">
            <Content />
          </div>
        </>
      );
    })}
  </div>

  <div class="experience">
    <div class="experience-title">
      <p>Work Experience</p>
    </div>

    {experienceEntries.map(async (job) => {
      const { Content } = await render(job);
      return (
        <>
          <div class="job-date">
            <p>{job.data.dateRange}</p>
          </div>
          <div class="job-entry">
            <p class="job-title">{job.data.title}</p>
            <div class="job-description">
              <Content />
            </div>
            <p class="job-stack">{job.data.stack}</p>
          </div>
        </>
      );
    })}
  </div>

  <div class="links">
    <div class="links-title">
      <p>Links</p>
    </div>

    <div class="social-entry">
      <p>GitHub</p>
    </div>
    <div class="social-handle">
      <a
        href="https://github.com/camescasse"
        target="_blank"
        rel="noopener noreferrer"
        >camescasse</a
      >
    </div>
    <div class="social-entry">
      <p>LinkedIn</p>
    </div>
    <div class="social-handle">
      <a
        href="https://linkedin.com/in/eric-camescasse"
        target="_blank"
        rel="noopener noreferrer"
        >Eric Camescasse</a
      >
    </div>
    <div class="social-entry">
      <p>Email</p>
    </div>
    <div class="social-handle">
      <a
        href="mailto:eric@camescasse.dev"
        target="_blank"
        rel="noopener noreferrer"
        >eric@camescasse.dev</a
      >
    </div>
  </div>
</BaseLayout>
